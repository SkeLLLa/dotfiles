{{- if eq .chezmoi.os "darwin" -}}
command = {{ .chezmoi.homeDir }}/.local/share/mise/shims/fish --login
{{ else -}}
command = /usr/bin/fish --login
{{ end -}}
shell-integration = fish
# Without no-cursor, shell integration forces a blinking bar at the prompt.
shell-integration-features = no-cursor
cursor-style = block
cursor-style-blink = false
app-notifications = false
notify-on-command-finish = unfocused
notify-on-command-finish-action = notify
background = #000000
background-opacity = 0.80
background-blur = true

# Use Plasma/KWin server-side decorations on this Wayland session.
window-decoration = server
gtk-titlebar = false

# Match ~/.config/wezterm/wezterm.lua: split right / below.
keybind = ctrl+shift+page_down=new_split:right
keybind = ctrl+shift+page_up=new_split:down

# Locale: en_CA text, C formats.
env = LANG=en_CA.UTF-8
env = LC_ADDRESS=C
env = LC_MEASUREMENT=C
env = LC_MONETARY=C
env = LC_NAME=C
env = LC_PAPER=C
env = LC_TELEPHONE=C
env = LC_TIME=C

#!/usr/bin/env bash
#MISE description="Install Nerd Fonts from the official release (macOS and Linux)"
# Usage: mise run install-nerd-fonts [--dir DIR] [FONT...]   (default font: JetBrainsMono)
#
# Portable on bash 3.2 (macOS) and newer: no associative arrays, no empty-array expansion.
set -eu

BASE_URL="https://github.com/ryanoasis/nerd-fonts/releases/latest/download"

case "$(uname -s)" in
  Darwin) FONT_DIR="${HOME}/Library/Fonts" ;;
  Linux) FONT_DIR="${XDG_DATA_HOME:-${HOME}/.local/share}/fonts" ;;
  *) echo "Unsupported OS: $(uname -s)" >&2; exit 1 ;;
esac

FONTS=""
while [ "$#" -gt 0 ]; do
  case "$1" in
    --dir) [ "$#" -ge 2 ] || { echo "--dir needs a value" >&2; exit 1; }; FONT_DIR="$2"; shift 2 ;;
    --dir=*) FONT_DIR="${1#--dir=}"; shift ;;
    -*) echo "Unknown option: $1" >&2; exit 1 ;;
    *) FONTS="${FONTS} $1"; shift ;;
  esac
done
# Default font when none is given.
[ -n "$FONTS" ] || FONTS=" JetBrainsMono"

for tool in curl tar; do
  command -v "$tool" >/dev/null 2>&1 || { echo "Missing required tool: $tool" >&2; exit 1; }
done
# macOS bsdtar reads .tar.xz natively; GNU tar needs the xz binary.
if ! tar --version 2>&1 | grep -qiE 'bsd|libarchive'; then
  command -v xz >/dev/null 2>&1 || { echo "GNU tar needs xz: install it first" >&2; exit 1; }
fi

TMP="$(mktemp -d)"
trap 'rm -rf "$TMP"' EXIT
mkdir -p "$FONT_DIR"

for font in $FONTS; do
  echo "==> ${font}"
  archive="${TMP}/${font}.tar.xz"
  if ! curl -fSL --retry 3 -o "$archive" "${BASE_URL}/${font}.tar.xz"; then
    echo "Download failed for '${font}' (is the name right? see https://www.nerdfonts.com/font-downloads)" >&2
    exit 1
  fi
  dest="${FONT_DIR}/NerdFonts-${font}"
  rm -rf "$dest"
  mkdir -p "$dest"
  # Keep only font files; skip the bundled license/readme.
  tar -xJf "$archive" -C "$dest" --wildcards '*.ttf' '*.otf' 2>/dev/null \
    || tar -xf "$archive" -C "$dest"
  echo "    installed to ${dest}"
done

if [ "$(uname -s)" = "Linux" ] && command -v fc-cache >/dev/null 2>&1; then
  fc-cache -f "$FONT_DIR"
fi
echo "Done."

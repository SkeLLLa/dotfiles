"$schema" = 'https://starship.rs/config-schema.json'

right_format = """
[](fg:color_bg_l3)\
$character\
[](bg:color_bg_l3 fg:color_bg_l2)\
$cmd_duration\
[](bg:color_bg_l2 fg:color_bg_l1)\
$time\
[](bg:color_bg_l1 fg:color_bg_l0)\
[ ](bg:color_bg_l0)\
"""

format = """
[ ](fg:color_bg_l0)\
$username\
[](fg:color_bg_l0 bg:color_bg_l1)\
$directory\
[](fg:color_bg_l1 bg:color_bg_l2)\
${custom.git_branch}\
${custom.git_status}\
[](fg:color_bg_l2 bg:color_bg_l3)\
[](fg:color_bg_l3 bg:color_bg_l4)\
[](fg:color_bg_l4)\
$fill\
[](fg:color_bg_l4)\
$kubernetes\
$helm\
$terraform\
[](bg:color_bg_l4 fg:color_bg_l3)\
$package\
$nodejs\
$rust\
[](bg:color_bg_l3 fg:color_bg_l2)\
${custom.ip}\
[](bg:color_bg_l2 fg:color_bg_l1)\
${custom.battery}\
[](bg:color_bg_l1 fg:color_bg_l0)\
${custom.hostname}\
[ ](bg:color_bg_l0)\
$line_break\
$os
"""

palette = 'custom_dark'

[palettes.custom_dark]
color_bg_l0 = '#64b5f6'
color_bg_l1 = '#5a5a5a'
color_bg_l2 = '#81c784'
color_bg_l3 = '#ffcc80'
color_bg_l4 = '#b39ddb'
color_fg_l0 = '#e3f2fd'
color_fg_l1 = '#ffffff'
color_fg_l2 = '#5a5a5a'
color_fg_l3 = '#333333'
color_fg_l4 = '#ffebee'
color_user = '#e4e4e4'
color_root = '#cc241d'
color_green = '#98971a'
color_orange = '#d65d0e'
color_purple = '#b16286'
color_yellow = '#d79921'
color_black = '#000000'

[username]
style_user = 'bg:color_bg_l0 fg:color_user'
style_root = 'bg:color_bg_l0 fg:color_root'
format = '[ $user]($style)'
disabled = false
show_always = true
aliases = { "{{ .chezmoi.username }}" = " ", "root" = " " }

[directory]
style = 'bg:#5a5a5a fg:#ffffff'
read_only_style = 'bg:#5a5a5a fg:#c78481'
format = "[$read_only ]($read_only_style)[$path ]($style)"
truncation_length = 3
truncation_symbol = " /"
read_only = " 󰌾"

[directory.substitutions]
"documents" = "󰈙 "
"downloads" = " "
"music" = " "
"pictures" = " "
"dev" = " "
"~" = " "

[git_branch]
disabled = true

[git_status]
disabled = true

[fill]
symbol = ' '

[hostname]
disabled = true

[time]
disabled = false
time_format = "%R" # Hour:Minute Format
style = "fg:color_fg_l1 bg:color_bg_l1"
format = '[  $time ]($style)'

[character]
success_symbol = '[ ](fg:color_green bg:color_bg_l3)'
error_symbol = '[ ](fg:color_orange bg:color_bg_l3)'
format = '$symbol'

[cmd_duration]
min_time = 500
format = '[ $duration]($style)'
style = 'fg:color_fg_l2 bg:color_bg_l2'

[custom.git_branch]
command = "comb g git.branch 2>/dev/null"
when = "comb g.j git.branch >/dev/null 2>&1"
shell = ["sh", "-c"]
use_stdin = false
format = '[  $output ]($style)'
style = 'bg:color_bg_l2 fg:color_fg_l2'

[custom.git_status]
command = 'echo "!"'
when = 'test "$(comb g git.dirty 2>/dev/null)" = true'
shell = ["sh", "-c"]
use_stdin = false
format = '[ $output ]($style)'
style = 'bg:color_bg_l2 fg:color_fg_l2'

[custom.battery]
command = "comb g battery.percent 2>/dev/null; echo"
when = "true"
shell = ["sh", "-c"]
use_stdin = false
format = '[󰚥 $output% ]($style)'
style = 'fg:color_fg_l1 bg:color_bg_l1'

[custom.hostname]
command = "comb g hostname.short 2>/dev/null; echo"
when = 'test -n "$SSH_CONNECTION"'
shell = ["sh", "-c"]
use_stdin = false
format = '[ $output]($style)'
style = 'bg:color_bg_l0 fg:color_fg_l0'

[custom.ip]
command = "comb g public_ip.body 2>/dev/null"
when = "comb g.j public_ip.body >/dev/null 2>&1"
shell = ["sh", "-c"]
use_stdin = false
format = "[󰩠 $output]($style)"
style = "bg:color_bg_l2 fg:color_fg_l2"

[os]
disabled = false

[os.symbols]
Alpaquita = " "
Alpine = " "
AlmaLinux = " "
Amazon = " "
Android = " "
Arch = " "
Artix = " "
CentOS = " "
Debian = " "
DragonFly = " "
Emscripten = " "
EndeavourOS = " "
Fedora = " "
FreeBSD = " "
Garuda = "󰛓 "
Gentoo = " "
HardenedBSD = "󰞌 "
Illumos = "󰈸 "
Kali = " "
Linux = " "
Mabox = " "
Macos = " "
Manjaro = " "
Mariner = " "
MidnightBSD = " "
Mint = " "
NetBSD = " "
NixOS = " "
OpenBSD = "󰈺 "
openSUSE = " "
OracleLinux = "󰌷 "
Pop = " "
Raspbian = " "
Redhat = " "
RedHatEnterprise = " "
RockyLinux = " "
Redox = "󰀘 "
Solus = "󰠳 "
SUSE = " "
Ubuntu = " "
Unknown = " "
Void = " "
Windows = "󰍲 "

[helm]
format = '[⎈ $version ]($style)'
style = 'fg:color_fg_l4 bg:color_bg_l4'

[kubernetes]
disabled = false
detect_files = [".terraform-version", ".terraform.lock.hcl", "terragrunt.hcl"]
detect_extensions = ["tf", "tfvars"]
detect_folders = [".terraform"]
format = '[$symbol$context( \($namespace\))]($style) '
style = 'fg:color_fg_l4 bg:color_bg_l4'

[terraform]
format = '[$symbol$workspace ]($style)'
style = 'fg:color_fg_l4 bg:color_bg_l4'

[nodejs]
format = '[$symbol($version) ]($style)'
style = 'fg:color_fg_l3 bg:color_bg_l3'

[rust]
format = '[$symbol($version) ]($style)'
style = 'fg:color_fg_l3 bg:color_bg_l3'

[package]
format = '[$symbol$version ]($style)'
style = 'fg:color_fg_l3 bg:color_bg_l3'
display_private = true

"$schema" = 'https://starship.rs/config-schema.json'

scan_timeout = 200

right_format = """
[](fg:color_bg_l3)\
$character\
[](bg:color_bg_l3 fg:color_bg_l2)\
$cmd_duration\
[](bg:color_bg_l2 fg:color_bg_l1)\
$time\
[](bg:color_bg_l1 fg:color_bg_l0)\
[ ](bg:color_bg_l0)\
"""

format = """
[ ](fg:color_bg_l0)\
$username\
[](fg:color_bg_l0 bg:color_bg_l1)\
$directory\
[](fg:color_bg_l1 bg:color_bg_l2)\
${custom.sf_git_branch}\
${custom.sf_git_conflicted}\
${custom.sf_git_staged}\
${custom.sf_git_modified}\
${custom.sf_git_untracked}\
${custom.sf_git_ahead}\
${custom.sf_git_behind}\
[](fg:color_bg_l2 bg:color_bg_l3)\
[](fg:color_bg_l3 bg:color_bg_l4)\
[](fg:color_bg_l4)\
$fill\
[](fg:color_bg_l4)\
$kubernetes\
$helm\
$terraform\
[](bg:color_bg_l4 fg:color_bg_l3)\
$package\
$nodejs\
$rust\
[](bg:color_bg_l3 fg:color_bg_l2)\
${custom.sf_public_ip}\
[](bg:color_bg_l2 fg:color_bg_l1)\
${custom.sf_battery}\
[](bg:color_bg_l1 fg:color_bg_l0)\
$hostname\
[ ](bg:color_bg_l0)\
$line_break\
$os
"""

palette = 'custom_dark'

[palettes.custom_dark]
color_bg_l0 = '#64b5f6'
color_bg_l1 = '#5a5a5a'
color_bg_l2 = '#81c784'
color_bg_l3 = '#ffcc80'
color_bg_l4 = '#b39ddb'
color_fg_l0 = '#e3f2fd'
color_fg_l1 = '#ffffff'
color_fg_l2 = '#5a5a5a'
color_fg_l3 = '#333333'
color_fg_l4 = '#ffebee'
color_user = '#e4e4e4'
color_root = '#cc241d'
color_green = '#98971a'
color_orange = '#d65d0e'
color_purple = '#b16286'
color_yellow = '#d79921'
color_black = '#000000'

[username]
style_user = 'bg:color_bg_l0 fg:color_user'
style_root = 'bg:color_bg_l0 fg:color_root'
format = '[ $user]($style)'
disabled = false
show_always = true
aliases = { "{{ .chezmoi.username }}" = " ", "root" = " " }

[directory]
style = 'bg:#5a5a5a fg:#ffffff'
read_only_style = 'bg:#5a5a5a fg:#c78481'
format = "[$read_only ]($read_only_style)[$path ]($style)"
truncation_length = 3
truncation_symbol = " /"
read_only = " 󰌾"

[directory.substitutions]
"documents" = "󰈙 "
"downloads" = " "
"music" = " "
"pictures" = " "
"dev" = " "
"~" = " "

[fill]
symbol = ' '

[time]
disabled = false
time_format = "%R" # Hour:Minute Format
style = "fg:color_fg_l1 bg:color_bg_l1"
format = '[  $time ]($style)'

[character]
success_symbol = '[ ](fg:color_green bg:color_bg_l3)'
error_symbol = '[ ](fg:color_orange bg:color_bg_l3)'
format = '$symbol'

[cmd_duration]
min_time = 500
format = '[ $duration]($style)'
style = 'fg:color_fg_l2 bg:color_bg_l2'

# Git and battery are served from the star-forge cache (stfg, ~/.config/star-forge/config.toml).
[git_branch]
disabled = true

[git_status]
disabled = true

[battery]
disabled = true

[custom.sf_git_branch]
command = "git_branch"
shell = ["stfg"]
use_stdin = false
when = true
format = '([  $output ]($style))'
style = 'bg:color_bg_l2 fg:color_fg_l2'

[custom.sf_git_conflicted]
command = "git_conflicted"
shell = ["stfg"]
use_stdin = false
when = true
format = '([$output ]($style))'
style = 'bg:color_bg_l2 fg:color_fg_l2'

[custom.sf_git_staged]
command = "git_staged"
shell = ["stfg"]
use_stdin = false
when = true
format = '([$output ]($style))'
style = 'bg:color_bg_l2 fg:color_fg_l2'

[custom.sf_git_modified]
command = "git_modified"
shell = ["stfg"]
use_stdin = false
when = true
format = '([$output ]($style))'
style = 'bg:color_bg_l2 fg:color_fg_l2'

[custom.sf_git_untracked]
command = "git_untracked"
shell = ["stfg"]
use_stdin = false
when = true
format = '([$output ]($style))'
style = 'bg:color_bg_l2 fg:color_fg_l2'

[custom.sf_git_ahead]
command = "git_ahead"
shell = ["stfg"]
use_stdin = false
when = true
format = '([$output ]($style))'
style = 'bg:color_bg_l2 fg:color_fg_l2'

[custom.sf_git_behind]
command = "git_behind"
shell = ["stfg"]
use_stdin = false
when = true
format = '([$output ]($style))'
style = 'bg:color_bg_l2 fg:color_fg_l2'

[custom.sf_public_ip]
command = "public_ip"
shell = ["stfg"]
use_stdin = false
when = true
format = '([󰩠 $output ]($style))'
style = 'bg:color_bg_l2 fg:color_fg_l2'

[custom.sf_battery]
command = "battery"
shell = ["stfg"]
use_stdin = false
when = true
format = '([󰚥 $output% ]($style))'
style = 'fg:color_fg_l1 bg:color_bg_l1'

[hostname]
ssh_only = true
format = '[ $hostname]($style)'
style = 'bg:color_bg_l0 fg:color_fg_l0'

[os]
disabled = false

[os.symbols]
Alpaquita = " "
Alpine = " "
AlmaLinux = " "
Amazon = " "
Android = " "
Arch = " "
Artix = " "
CentOS = " "
Debian = " "
DragonFly = " "
Emscripten = " "
EndeavourOS = " "
Fedora = " "
FreeBSD = " "
Garuda = "󰛓 "
Gentoo = " "
HardenedBSD = "󰞌 "
Illumos = "󰈸 "
Kali = " "
Linux = " "
Mabox = " "
Macos = " "
Manjaro = " "
Mariner = " "
MidnightBSD = " "
Mint = " "
NetBSD = " "
NixOS = " "
OpenBSD = "󰈺 "
openSUSE = " "
OracleLinux = "󰌷 "
Pop = " "
Raspbian = " "
Redhat = " "
RedHatEnterprise = " "
RockyLinux = " "
Redox = "󰀘 "
Solus = "󰠳 "
SUSE = " "
Ubuntu = " "
Unknown = " "
Void = " "
Windows = "󰍲 "

[helm]
format = '[⎈ $version ]($style)'
style = 'fg:color_fg_l4 bg:color_bg_l4'

[kubernetes]
disabled = false
detect_files = [".terraform-version", ".terraform.lock.hcl", "terragrunt.hcl"]
detect_extensions = ["tf", "tfvars"]
detect_folders = [".terraform"]
format = '[$symbol$context( \($namespace\)) ]($style)'
style = 'fg:color_fg_l4 bg:color_bg_l4'

[terraform]
format = '[$symbol$workspace ]($style)'
style = 'fg:color_fg_l4 bg:color_bg_l4'

[nodejs]
format = '[$symbol($version) ]($style)'
style = 'fg:color_fg_l3 bg:color_bg_l3'

[rust]
format = '[$symbol($version) ]($style)'
style = 'fg:color_fg_l3 bg:color_bg_l3'

[package]
format = '[$symbol$version ]($style)'
style = 'fg:color_fg_l3 bg:color_bg_l3'
display_private = true

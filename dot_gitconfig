[init]
	defaultBranch = master

[core]
	excludesFile = ~/.config/git/ignore

[include]
	path = ~/.gitconfig.local

# Syntax-aware merges via mergiraf (file list in ~/.config/git/attributes);
# leftover conflicts go to kdiff3 with `git mergetool`.
[merge]
	conflictStyle = diff3
	tool = kdiff3

[merge "mergiraf"]
	name = mergiraf
	driver = mergiraf merge --git %O %A %B -s %S -x %X -y %Y -p %P -l %L

[mergetool]
	keepBackup = false
